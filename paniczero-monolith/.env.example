# PanicZero — Environment Configuration
# Copy this file to .env and fill in your values.

# Google Gemini API Key (Required for AI-powered triage & code rectification)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (local development only — Vercel ignores this)
PORT=8080
